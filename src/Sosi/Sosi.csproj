<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Sosi</RootNamespace>
    <AssemblyName>Sosi</AssemblyName>
    <Description>Reader for SOSI files (Norwegian GIS format). Port of the "lite" variant of sosi.js.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sosi.Tests" />
  </ItemGroup>

</Project>
